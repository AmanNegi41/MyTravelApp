@model MyTravelApp.Models.Models.HotelSearchResult
@{

    Layout = "_Layout";
    ViewData["Title"] = "Hotel Results";
    var hotels = Model?.Hotels ?? new List<MyTravelApp.Models.Models.Hotel>();
    var maxPrice = hotels.Where(h => h.PriceAmount > 0).Select(h => h.PriceAmount).DefaultIfEmpty(10000).Max();
    var sliderMax = (int)Math.Ceiling(maxPrice / 100m) * 100;
    if (sliderMax < 500) { sliderMax = 500; }
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0F2A3D;
        --ink-soft: #5A6B78;
        --line: #E2E8F0;
        --bg: #F8FAFC;
        --surface: #FFFFFF;
        --accent: #0E7C7B;
        --accent-dark: #0A5E5D;
        --accent-tint: #E7F4F3;
        --star: #F59E0B;
        --radius-lg: 16px;
        --radius-md: 12px;
        --radius-sm: 8px;
        --shadow-sm: 0 1px 3px rgba(15,42,61,0.06);
        --shadow-hover: 0 12px 24px -8px rgba(15,42,61,0.12);
    }

    .hr-container {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg);
        color: var(--ink);
        padding: 24px 0 64px 0;
        min-height: 80vh;
    }

    /* Subheader Navigation */
    .hr-header {
        max-width: 1280px;
        margin: 0 auto 24px auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .hr-title-group h1 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.6rem;
        font-weight: 800;
        margin: 4px 0 0 0;
        color: var(--ink);
    }

    .hr-back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.88rem;
    }

        .hr-back-link:hover {
            text-decoration: underline;
        }

    .hr-meta-info {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin-top: 2px;
    }

    /* Main Responsive Grid Layout */
    .hr-layout {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 24px;
        align-items: start;
    }

    /* Sidebar Filters */
    .hr-sidebar {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 20px;
        box-shadow: var(--shadow-sm);
        position: sticky;
        top: 24px;
    }

    .hr-filter-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

        .hr-filter-title h3 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

    .hr-btn-clear {
        background: none;
        border: none;
        color: var(--accent);
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
    }

    .hr-filter-section {
        padding: 16px 0;
        border-top: 1px solid var(--line);
    }

    .hr-filter-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-soft);
        margin-bottom: 12px;
    }

    .hr-price-range {
        display: flex;
        justify-content: space-between;
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .hr-slider {
        width: 100%;
        accent-color: var(--accent);
        cursor: pointer;
    }

    .hr-checkbox-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.88rem;
        margin-bottom: 8px;
        cursor: pointer;
        user-select: none;
    }

        .hr-checkbox-item input {
            accent-color: var(--accent);
        }

    /* Results Toolbar */
    .hr-results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .hr-results-count {
        font-size: 0.92rem;
        color: var(--ink-soft);
    }

    .hr-sort-select {
        padding: 8px 12px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--line);
        background: var(--surface);
        font-family: inherit;
        font-size: 0.88rem;
        color: var(--ink);
    }

    /* Cards Layout */
    .hr-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 20px;
    }

    .hr-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
    }

        .hr-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

    .hr-card-img-wrap {
        position: relative;
        width: 100%;
        height: 180px;
        background: var(--line);
    }

        .hr-card-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .hr-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: var(--ink);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 4px;
        text-transform: uppercase;
    }

    .hr-card-content {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .hr-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 6px;
    }

    .hr-hotel-name {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
        line-height: 1.3;
    }

    .hr-star-rating {
        color: var(--star);
        font-size: 0.8rem;
        flex-shrink: 0;
    }

    .hr-location {
        font-size: 0.82rem;
        color: var(--ink-soft);
        margin-bottom: 12px;
    }

    .hr-card-footer {
        margin-top: auto;
        padding-top: 12px;
        border-top: 1px dashed var(--line);
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }

    .hr-price-tag {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--ink);
    }

    .hr-price-sub {
        display: block;
        font-size: 0.72rem;
        color: var(--ink-soft);
        font-weight: 400;
    }

    .hr-btn-action {
        background: var(--accent);
        color: #fff;
        border: none;
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background 0.15s ease;
    }

        .hr-btn-action:hover {
            background: var(--accent-dark);
        }

    .hr-hidden {
        display: none !important;
    }

    @@media (max-width: 900px) {
        .hr-layout {
            grid-template-columns: 1fr;
        }

        .hr-sidebar {
            position: static;
        }
    }
</style>

<div class="hr-container">
    <div class="hr-header">
        <div class="hr-title-group">
            <a class="hr-back-link" asp-controller="Dashboard" asp-action="Index">&larr; Back to search</a>
            <h1>Stays in @(string.IsNullOrWhiteSpace(Model?.Destination) ? "Selected Destination" : Model.Destination)</h1>
            <div class="hr-meta-info">
                @if (Model != null && !string.IsNullOrWhiteSpace(Model.CheckInDate))
                {
                    <span>@Model.CheckInDate to @Model.CheckOutDate &middot; @Model.Adults Guest(s)</span>
                }
            </div>
        </div>
    </div>

    <div class="hr-layout">
        <!-- Sidebar Filter -->
        <aside class="hr-sidebar">
            <div class="hr-filter-title">
                <h3>Filters</h3>
                <button type="button" class="hr-btn-clear" id="hr-reset">Clear all</button>
            </div>

            <div class="hr-filter-section">
                <div class="hr-filter-label">Max Price Per Night</div>
                <div class="hr-price-range">
                    <span>₹0</span>
                    <span id="hr-price-val">₹@sliderMax</span>
                </div>
                <input type="range" class="hr-slider" id="hr-price-slider" min="0" max="@sliderMax" value="@sliderMax" step="100">
            </div>

            <div class="hr-filter-section">
                <div class="hr-filter-label">Star Rating</div>
                @for (int s = 5; s >= 2; s--)
                {
                    <label class="hr-checkbox-item">
                        <input type="checkbox" class="hr-star-chk" value="@s">
                        <span>@s Stars</span>
                    </label>
                }
            </div>
        </aside>

        <!-- Main Results Grid -->
        <main>
            @if (hotels.Count == 0)
            {
                <div style="background:#fff; border:1px solid var(--line); border-radius:16px; padding:48px; text-align:center;">
                    <h3>No properties found</h3>
                    <p style="color:var(--ink-soft);">Try modifying your search criteria or dates.</p>
                </div>
            }
            else
            {
                <div class="hr-results-header">
                    <span class="hr-results-count"><strong id="hr-count">@hotels.Count</strong> properties matching</span>
                    <select class="hr-sort-select" id="hr-sorter">
                        <option value="default">Sort by: Recommended</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="rating">Rating</option>
                    </select>
                </div>
                <!-- WITH THIS -->
                <div class="hr-grid" id="hr-grid">
                    @{
                        var fallbackImages = new[] { "/img/packages-1.jpg", "/img/packages-2.jpg", "/img/carousel-1.jpg", "/img/carousel-2.jpg" };
                    }
                    @for (int i = 0; i < hotels.Count; i++)
                    {
                        var hotel = hotels[i];
                        var starCount = hotel.Rating > 0 ? (int)Math.Clamp(Math.Round(hotel.Rating), 1, 5) : 3;
                        var fallbackImg = fallbackImages[i % fallbackImages.Length];

                        <div class="hr-card"
                             data-price="@hotel.PriceAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             data-rating="@hotel.Rating.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             data-stars="@starCount">
                            <div class="hr-card-img-wrap">
                                @if (hotel.Rating >= 4.5)
                                {
                                    <span class="hr-badge">Top Rated</span>
                                }
                                <img src="@(string.IsNullOrWhiteSpace(hotel.ImageUrl) ? fallbackImg : hotel.ImageUrl)"
                                     alt="@hotel.Name"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='@fallbackImg';" />
                            </div>
                            <div class="hr-card-content">
                                <div class="hr-card-header">
                                    <h3 class="hr-hotel-name">@hotel.Name</h3>
                                    <div class="hr-star-rating">&#9733; @starCount</div>
                                </div>
                                <div class="hr-location">@(string.IsNullOrWhiteSpace(hotel.Location) ? hotel.City : hotel.Location)</div>
                                <div class="hr-card-footer">
                                    <div>
                                        <div class="hr-price-tag">@(string.IsNullOrWhiteSpace(hotel.Price) ? "Rates on Request" : hotel.Price)</div>
                                        <span class="hr-price-sub">per night</span>
                                    </div>
                                    <button type="button" class="hr-btn-action">View Deal</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

            }
        </main>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const slider = document.getElementById("hr-price-slider");
        const priceLabel = document.getElementById("hr-price-val");
        const starBoxes = document.querySelectorAll(".hr-star-chk");
        const grid = document.getElementById("hr-grid");
        const countLabel = document.getElementById("hr-count");
        const sorter = document.getElementById("hr-sorter");
        const resetBtn = document.getElementById("hr-reset");

        function filterHotels() {
            if (!grid) return;
            const maxPrice = parseFloat(slider.value);
            const selectedStars = Array.from(starBoxes).filter(cb => cb.checked).map(cb => parseInt(cb.value));
            let visible = 0;

            Array.from(grid.children).forEach(card => {
                const price = parseFloat(card.getAttribute("data-price") || "0");
                const stars = parseInt(card.getAttribute("data-stars") || "0");

                let matchesPrice = price === 0 || price <= maxPrice;
                let matchesStar = selectedStars.length === 0 || selectedStars.includes(stars);

                if (matchesPrice && matchesStar) {
                    card.classList.remove("hr-hidden");
                    visible++;
                } else {
                    card.classList.add("hr-hidden");
                }
            });

            if (countLabel) countLabel.textContent = visible;
        }

        if (slider) {
            slider.addEventListener("input", function () {
                priceLabel.textContent = "₹" + slider.value;
                filterHotels();
            });
        }

        starBoxes.forEach(box => box.addEventListener("change", filterHotels));

        if (resetBtn) {
            resetBtn.addEventListener("click", function () {
                if (slider) {
                    slider.value = slider.max;
                    priceLabel.textContent = "₹" + slider.max;
                }
                starBoxes.forEach(cb => cb.checked = false);
                filterHotels();
            });
        }

        if (sorter && grid) {
            sorter.addEventListener("change", function () {
                const cards = Array.from(grid.children);
                const val = sorter.value;

                cards.sort((a, b) => {
                    const priceA = parseFloat(a.getAttribute("data-price") || "0");
                    const priceB = parseFloat(b.getAttribute("data-price") || "0");
                    const ratingA = parseFloat(a.getAttribute("data-rating") || "0");
                    const ratingB = parseFloat(b.getAttribute("data-rating") || "0");

                    if (val === "price-asc") return priceA - priceB;
                    if (val === "price-desc") return priceB - priceA;
                    if (val === "rating") return ratingB - ratingA;
                    return 0;
                });

                cards.forEach(card => grid.appendChild(card));
            });
        }
    });
</script>